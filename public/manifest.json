{
  "manifest_version": 3,
  "name": "Bookmarkify",
  "version": "0.1.0",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "permissions": ["bookmarks"],
  "optional_permissions": ["downloads"],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Bookmarkify"
  }
}
